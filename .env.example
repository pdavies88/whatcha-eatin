# Server-only settings for the free provider (src/app/api/analyze+api.ts).
# Copy to .env.local for development. Do NOT prefix with EXPO_PUBLIC_: that would
# bundle the key into the app where anyone could extract it.

# Free-tier key from https://aistudio.google.com/app/apikey
FREE_GEMINI_API_KEY=

# Optional: override the free model
# FREE_GEMINI_MODEL=gemini-3.5-flash-lite
